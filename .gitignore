# Dependencies. No trailing slash, so a reused node_modules symlink is ignored too.
node_modules

# Build output
dist/
build/
target/
coverage/
*.tsbuildinfo
**/*.rs.bk

# Tauri
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/.cargo/

# Python
__pycache__/
*.py[cod]

# Pinned speech runtime: provision it separately and never commit model
# weights or host binaries (docs/linux-packaging.md#runtime-provisioning).
models/
runtime/speech/lib/
runtime/speech/*.so

# Real-worker protocol receipts belong in external evidence directories.
runtime/speech/worker-protocol*.json
runtime/speech/worker-protocol.stderr

# Local environment
.env
.env*.local
.tmp/

# Package managers
.npm
*.tgz
npm-debug.log*
yarn-debug.log*

# Logs
*.log
logs/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
