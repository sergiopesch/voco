+// Explicit experiment setting; default remains the upstream four threads.
+int cpu_threads() {
+    static const int value = [] {
+        const char* raw = std::getenv("NEMO_SPEECH_CPU_THREADS");
+        if (!raw) return 4;
+        char* end = nullptr;
+        const long parsed = std::strtol(raw, &end, 10);
+        if (end == raw || *end != '\0' || parsed < 1 || parsed > 16)
+            throw std::invalid_argument("NEMO_SPEECH_CPU_THREADS must be between 1 and 16");
+        return static_cast<int>(parsed);
+    }();
+    return value;
+}
+
