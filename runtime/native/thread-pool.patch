+    if (std::getenv("NEMO_SPEECH_DISABLE_POOL") == nullptr) {
+        auto pool_params = ggml_threadpool_params_default(cpu_threads());
+        pool_params.poll = 0; // sleep between graphs instead of burning idle CPU
