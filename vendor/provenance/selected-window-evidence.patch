 impl WhisperState {
+    /// Copy the latest call's selected-seek evidence. Unavailable evidence is an error.
+    pub fn selected_window_evidence(&self) -> Result<Vec<SelectedWindowEvidence>, WhisperError> {
+        if !self.latest_full_invoked_native {
+            return Err(WhisperError::NoSamples);
+        }
+        // SAFETY: this wrapper owns a live state; the native getter copies numeric fields.
+        let count = unsafe {
+            whisper_rs_sys::whisper_full_selected_window_evidence_count_from_state(self.ptr)
+        };
+        if !(0..=4096).contains(&count) {
+            return Err(WhisperError::GenericError(-1));
+        }
+        let mut result = Vec::with_capacity(count as usize);
+        for index in 0..count {
+            let mut raw =
+                std::mem::MaybeUninit::<whisper_rs_sys::whisper_selected_window_evidence>::uninit();
+            // SAFETY: native initializes the whole output only on success; index is bounded.
+            if !unsafe {
+                whisper_rs_sys::whisper_full_selected_window_evidence_from_state(
+                    self.ptr,
+                    index,
+                    raw.as_mut_ptr(),
+                )
+            } {
+                return Err(WhisperError::GenericError(-1));
+            }
+            // SAFETY: the successful getter initialized every field.
+            let raw = unsafe { raw.assume_init() };
+            result.push(SelectedWindowEvidence {
+                seek: raw.seek,
+                structural: raw.structural,
+                actual_eot: raw.actual_eot,
+                entropy_rejected: raw.entropy_rejected,
+                native_failed: raw.native_failed,
+                completed: raw.completed,
+                avg_logprob: raw.avg_logprob,
+                original_no_speech: raw.original_no_speech,
+                lexical_no_speech: raw.lexical_no_speech,
+                text_tokens: raw.text_tokens,
+            });
+        }
+        Ok(result)
+    }
