+extern "C" bool whisper_full_selected_window_evidence_from_state(
+        const struct whisper_state * state, int index, struct whisper_selected_window_evidence * out) {
+    if (state == nullptr || out == nullptr || state->selected_window_evidence_overflow ||
+        index < 0 || static_cast<size_t>(index) >= state->selected_window_evidence.size()) {
+        return false;
+    }
+    *out = state->selected_window_evidence[static_cast<size_t>(index)];
+    return true;
