+static void ggml_barrier_wait_init(struct ggml_threadpool * tp) {
+    atomic_init(&tp->barrier_waiters, 0);
+    tp->barrier_wait_enabled = false;
+    if (pthread_mutex_init(&tp->barrier_mutex, NULL) != 0) {
+        return;
