+static void ggml_barrier_wait_destroy(struct ggml_threadpool * tp) {
+    if (tp->barrier_wait_enabled) {
+        GGML_ASSERT(atomic_load_explicit(&tp->barrier_waiters, memory_order_relaxed) == 0);
+        pthread_cond_destroy(&tp->barrier_cond);
+        pthread_mutex_destroy(&tp->barrier_mutex);
+    }
+}
+#endif
