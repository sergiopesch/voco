+    /// Whether an existing entropy or repetition-loop rejection occurred in a selected
+    /// seek's temperature history. Independent of final confidence and not a VAD signal.
+    /// Unavailable before a native full call or after a wrapper-level input rejection.
+    pub fn had_repetition_rejection_history(&self) -> Result<bool, WhisperError> {
+        if !self.latest_full_invoked_native {
+            return Err(WhisperError::NoSamples);
+        }
+        // SAFETY: this wrapper owns a live state and the getter only reads numeric state.
+        Ok(unsafe {
+            whisper_rs_sys::whisper_full_had_repetition_rejection_history_from_state(self.ptr)
+        })
+    }
