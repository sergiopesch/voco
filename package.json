{
  "name": "voco",
  "version": "2026.0.62",
  "description": "The voice layer for Linux, starting with dictation",
  "license": "MIT",
  "homepage": "https://github.com/sergiopesch/voco#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiopesch/voco.git"
  },
  "bugs": {
    "url": "https://github.com/sergiopesch/voco/issues"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "lint": "npm run lint -w apps/desktop",
    "check": "npm run check --workspaces --if-present",
    "test": "bash scripts/test-unit.sh",
    "test:ibus": "PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 apps/desktop/src-tauri/resources/voco_ibus_protocol_test.py && PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 apps/desktop/src-tauri/resources/voco_ibus_engine_test.py",
    "test:speech-baseline": "node scripts/test-speech-baseline.mjs",
    "test:browser-full-app": "bash scripts/test-browser-full-app.sh",
    "test:chromium-exact-field": "node scripts/chromium-background.test.cjs && node scripts/chromium-content-lifecycle.test.cjs && node scripts/test-chromium-exact-field.mjs",
    "test:application-delivery": "bash scripts/test-application-delivery.sh",
    "test:browser-delivery": "VOCO_DELIVERY_SUITE=browser bash scripts/test-application-delivery.sh",
    "test:brand-motion": "node scripts/test-brand-motion.mjs",
    "test:dictation-renderer": "node scripts/test-dictation-renderer.mjs",
    "test:microphone-renderer": "node scripts/test-microphone-app-renderer.mjs",
    "test:private-ibus": "PYTHONDONTWRITEBYTECODE=1 bash scripts/test-private-ibus-engine.sh",
    "test:native-desktop": "PYTHONDONTWRITEBYTECODE=1 bash scripts/test-native-desktop.sh",
    "verify:versions": "node scripts/check-version-consistency.mjs",
    "verify:devops": "bash ./scripts/check-devops.sh",
    "verify:security": "npm audit --audit-level=moderate",
    "rehearse:release": "bash ./scripts/rehearse-release.sh",
    "report:performance": "python3 scripts/report-performance.py",
    "report:linux-runtime": "bash ./scripts/report-linux-runtime.sh",
    "test:native-capture-renderer": "node scripts/test-native-capture-renderer.mjs",
    "test:native-capture-callbacks": "python3 scripts/test-native-capture-callbacks.py",
    "test:native-capture-audit": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test_verify_native_capture_audit.py",
    "test:speech-runtime": "PYTHONDONTWRITEBYTECODE=1 /usr/bin/python3 -m unittest discover -s runtime/speech -p \"test_*.py\"",
    "test:speech-package": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-speech-package.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-debian-maintainer.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-rpm-package.py",
    "test:speech-report": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-report-speech-timing.py",
    "test:dictation-quality": "node --test scripts/dictation-quality.test.mjs",
    "test:dictation-quality-events": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-report-dictation-quality-events.py",
    "test:dictation-evaluation": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-typesafe-evaluation.py && node --test scripts/score-dictation-worker.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "^8.3.3"
  }
}
