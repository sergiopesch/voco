# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py,c,h,in}]
indent_size = 4

[packaging/ydotool/voco-ydotool-launcher]
indent_size = 4

# Blank context lines in a patch end with a space.
[*.patch]
trim_trailing_whitespace = false

# Pinned third-party source and notices stay byte-for-byte.
[{vendor/**,runtime/notices/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
