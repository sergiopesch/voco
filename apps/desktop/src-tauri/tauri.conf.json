{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri2-schema/main/tauri.conf.json",
  "productName": "VOCO",
  "version": "2026.0.48",
  "identifier": "com.sergiopesch.voco",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VOCO",
        "width": 1,
        "height": 1,
        "x": -100,
        "y": -100,
        "resizable": false,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; media-src 'self' mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Turn speech into text at your cursor with local dictation",
    "longDescription": "Your voice, typed. VOCO turns speech into text at your cursor on Linux. Press a shortcut, speak, and press it again to finish. English recognition runs locally on the CPU with no account or subscription. VOCO stays in the tray and offers microphone and shortcut setup. Delivery uses clipboard paste and depends on the desktop session and target field. Interrupted transcripts remain available for recovery.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.sergiopesch.voco.metainfo.xml": "../../../packaging/tauri/com.sergiopesch.voco.metainfo.xml"
        }
      },
      "deb": {
        "desktopTemplate": "../../../packaging/tauri/VOCO.desktop",
        "depends": [
          "libpulse0",
          "libnotify-bin",
          "ibus",
          "python3",
          "gir1.2-ibus-1.0",
          "python3-gi",
          "xclip",
          "gir1.2-atspi-2.0",
          "at-spi2-core",
          "python3-numpy",
          "python3-psutil",
          "procps",
          "libsentencepiece0",
          "xdotool",
          "wl-clipboard",
          "libc6 (>= 2.39)",
          "libstdc++6 (>= 13.2.0)"
        ],
        "files": {
          "/usr/share/metainfo/com.sergiopesch.voco.metainfo.xml": "../../../packaging/tauri/com.sergiopesch.voco.metainfo.xml",
          "/usr/share/ibus/component/voco.xml": "../../../packaging/ibus/voco.xml",
          "/usr/libexec/voco-ibus-engine": "../../../packaging/ibus/voco-ibus-engine",
          "/usr/lib/voco/ibus/voco_ibus_engine.py": "resources/voco_ibus_engine.py",
          "/usr/lib/voco/ibus/voco_ibus_ownership.py": "resources/voco_ibus_ownership.py",
          "/usr/lib/voco/ibus/voco_ibus_protocol.py": "resources/voco_ibus_protocol.py",
          "/usr/share/doc/voco/THIRD-PARTY-NOTICES.txt": "../../../vendor/THIRD-PARTY-NOTICES.txt",
          "/etc/opt/chrome/native-messaging-hosts/com.voco.exact_field.json": "../../../packaging/chromium/com.voco.exact_field.json",
          "/etc/chromium/native-messaging-hosts/com.voco.exact_field.json": "../../../packaging/chromium/com.voco.exact_field.json",
          "/usr/share/voco/chromium/manifest.json": "../../../integrations/chromium/manifest.json",
          "/usr/share/voco/chromium/background.js": "../../../integrations/chromium/background.js",
          "/usr/share/voco/chromium/content.js": "../../../integrations/chromium/content.js",
          "/usr/lib/systemd/user/voco-ydotoold.service": "../../../packaging/systemd/voco-ydotoold.service"
        },
        "recommends": [
          "ydotool",
          "ydotoold"
        ]
      }
    }
  },
  "plugins": {
    "global-shortcut": null
  }
}
