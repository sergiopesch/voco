voco_ui_configure() {
  local columns="${VOCO_TERMINAL_COLUMNS:-80}" rows="${VOCO_TERMINAL_ROWS:-24}"
  if [[ "${VOCO_INSTALL_PLAIN:-0}" == 1 || ! "$columns" =~ ^[0-9]+$ || "$columns" -lt 64 || ! "$rows" =~ ^[0-9]+$ || "$rows" -lt 12 ]]; then
    VOCO_TERMINAL_MOTION=false
    DIM='' GREEN='' YELLOW='' RED='' NC=''
  fi
  if [[ "${VOCO_INSTALL_NO_MOTION:-0}" == 1 ]]; then
    VOCO_UI_NO_MOTION=true
  elif [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] && command -v gsettings >/dev/null 2>&1; then
    if [[ "$(gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null)" == false ]]; then
      VOCO_UI_NO_MOTION=true
    fi
  fi
  VOCO_UI_LINES=10
  VOCO_UI_ART=false
  # The card needs 24-bit colour and room for its 21 lines; other terminals keep
  # the compact canvas, which names VOCO in one line.
  if [[ "$VOCO_TERMINAL_MOTION" == true && "$rows" -ge 23 && "${COLORTERM:-}" =~ ^(truecolor|24bit)$ ]]; then
    VOCO_UI_ART=true
    VOCO_UI_LINES=$((VOCO_UI_CARD_ROWS + 2 + VOCO_UI_PROGRESS_LINES))
    voco_ui_art_mode "$columns" "$rows"
    voco_ui_art_build
  fi
  [[ "$VOCO_TERMINAL_MOTION" == true ]] || return 0
}

voco_ui_now_ms() {
  VOCO_UI_NOW=$(( ${EPOCHREALTIME/./} / 1000 ))
}

# How the card shows the microphone. A terminal that answers the kitty graphics
# query gets the image, any other a mosaic of the symbols it draws itself.
voco_ui_art_mode() {
  [[ -z "$VOCO_UI_MIC_MODE" ]] || return 0
  case "${VOCO_INSTALL_ART:-}" in
    kitty|octant|sextant|quadrant) VOCO_UI_MIC_MODE=$VOCO_INSTALL_ART ;;
    text) voco_ui_mosaic ;;
    *)
      # Over SSH an answer can arrive after the probe stops waiting and reach a
      # later prompt, so only a local terminal is asked.
      [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]] || voco_ui_probe "$1" "$2"
      if [[ "$VOCO_UI_GRAPHICS" == kitty ]]; then VOCO_UI_MIC_MODE=kitty; else voco_ui_mosaic; fi
      ;;
  esac
}

# Ask the terminal whether it shows kitty images and how big its cells are. It
# answers DA1 last, and every terminal answers DA1, so the probe ends once the
# answers are in, or after VOCO_UI_PROBE_MS. Echo stays off meanwhile, so no
# answer reaches the screen, and the terminal gets its own settings back.
voco_ui_probe() {
  local columns="$1" rows="$2" pid=$BASHPID process tty saved reply='' char remaining wait deadline
  local -a stat
  local kitty=$'\e_G[^;\e]*i='"$VOCO_UI_IMAGE_ID"$'[^;\e]*;OK\e' da1=$'\e\\[\\?[0-9;]*c'
  local cell=$'\e\\[6;([0-9]+);([0-9]+)t' area=$'\e\\[4;([0-9]+);([0-9]+)t'
  # Only the foreground job may use the terminal: a background one would stop.
  # The process group and the terminal's foreground group follow the command name.
  [[ -r "/proc/$pid/stat" ]] || return 0
  process=$(< "/proc/$pid/stat")
  read -r -a stat <<< "${process##*) }"
  [[ -n "${stat[5]:-}" && "${stat[2]}" == "${stat[5]}" ]] || return 0
  { exec {tty}<> /dev/tty; } 2>/dev/null || return 0
  if saved=$(stty -g <&"$tty" 2>/dev/null); then
    VOCO_UI_PROBE_TTY=$saved
    trap '' TTIN TTOU
    stty -echo -icanon min 1 time 0 <&"$tty" 2>/dev/null || true
    printf '\033_Gi=%d,s=1,v=1,a=q,t=d,f=24;AAAA\033\\\033[16t\033[14t\033[c' "$VOCO_UI_IMAGE_ID" >&"$tty" || true
    voco_ui_now_ms
    deadline=$((VOCO_UI_NOW + VOCO_UI_PROBE_MS))
    while voco_ui_now_ms; remaining=$((deadline - VOCO_UI_NOW)); (( remaining > 0 )); do
      printf -v wait '%d.%03d' $((remaining / 1000)) $((remaining % 1000))
      IFS= read -r -n 1 -d '' -t "$wait" char <&"$tty" || break
      reply+=$char
      [[ ! "$reply" =~ $da1 ]] || break
    done
    stty "$saved" <&"$tty" 2>/dev/null || true
    VOCO_UI_PROBE_TTY=''
    trap - TTIN TTOU
  fi
  exec {tty}>&-
  [[ ! "$reply" =~ $kitty ]] || VOCO_UI_GRAPHICS=kitty
  if [[ "$reply" =~ $cell ]]; then
    VOCO_UI_CELL_HEIGHT=${BASH_REMATCH[1]} VOCO_UI_CELL_WIDTH=${BASH_REMATCH[2]}
  elif [[ "$reply" =~ $area ]]; then
    VOCO_UI_CELL_HEIGHT=$((BASH_REMATCH[1] / rows)) VOCO_UI_CELL_WIDTH=$((BASH_REMATCH[2] / columns))
  fi
}

# The mosaic for a terminal that shows no images: octants or sextants where the
# terminal draws them itself, so its font can't lack them, otherwise quadrants,
# which every terminal font has. Inside tmux or screen the terminal is unknown.
voco_ui_mosaic() {
  local vte="${VTE_VERSION:-0}"
  [[ "$vte" =~ ^[0-9]+$ ]] || vte=0
  VOCO_UI_MIC_MODE=quadrant
  case "${TMUX:-}${STY:-}:${TERM:-}" in
    ?*:*|:screen*|:tmux*) return 0 ;;
  esac
  if (( vte >= 7800 )); then
    VOCO_UI_MIC_MODE=octant
  elif (( vte >= 6400 )); then
    VOCO_UI_MIC_MODE=sextant
  else
    case "${TERM_PROGRAM:-}:${TERM:-}" in
      ghostty:*|WezTerm:*|*:xterm-kitty|*:foot|*:foot-extra) VOCO_UI_MIC_MODE=sextant ;;
    esac
  fi
}

# The image goes to the terminal once. The card then places it over the
# microphone's cells, cropped to the shape of the terminal's cells around the
# microphone, so it fills them without stretching. Cells of unknown size are
# taken to be twice as tall as they are wide.
voco_ui_image_build() {
  local cw=$VOCO_UI_CELL_WIDTH ch=$VOCO_UI_CELL_HEIGHT width=${VOCO_UI_IMAGE_SIZE[0]} height=${VOCO_UI_IMAGE_SIZE[1]}
  local left=${VOCO_UI_IMAGE_MIC[0]} top=${VOCO_UI_IMAGE_MIC[1]} mw=${VOCO_UI_IMAGE_MIC[2]} mh=${VOCO_UI_IMAGE_MIC[3]}
  local w h x y k i=0 data=$VOCO_UI_IMAGE_PNG keys send=''
  (( cw > 0 && ch > 0 )) || { cw=1; ch=2; }
  # The microphone cells are 14 cell widths by 11 cell heights.
  if (( mw * 11 * ch >= mh * 14 * cw )); then
    w=$mw h=$(( (mw * 11 * ch + 7 * cw) / (14 * cw) ))
  else
    h=$mh w=$(( (mh * 14 * cw + 11 * ch / 2) / (11 * ch) ))
  fi
  (( w <= width )) || w=$width
  (( h <= height )) || h=$height
  x=$(( left + mw / 2 - w / 2 )) y=$(( top + mh / 2 - h / 2 ))
  (( x >= 0 )) || x=0
  (( x <= width - w )) || x=$((width - w))
  (( y >= 0 )) || y=0
  (( y <= height - h )) || y=$((height - h))
  # From just after the card, up to its first row and the microphone's column.
  # The cursor is saved around it, in case a terminal moves it anyway.
  VOCO_UI_PLACE=('')
  for ((k=1; k<=14; k++)); do
    VOCO_UI_PLACE+=($'\e7\e[12A\e[5G\e_Ga=p,i='"$VOCO_UI_IMAGE_ID,p=1,x=$x,y=$y,w=$(( (w * k + 7) / 14 )),h=$h,c=$k,r=11,C=1,q=2"$'\e\\\e8')
  done
  VOCO_UI_UNPLACE=$'\e_Ga=d,d=i,i='"$VOCO_UI_IMAGE_ID"$',p=1,q=2\e\\'
  # In chunks of at most 4096 bytes, as the protocol asks; q=2 keeps the
  # terminal from answering.
  keys="a=t,t=d,f=100,i=$VOCO_UI_IMAGE_ID,q=2,"
  while (( i < ${#data} )); do
    send+=$'\e_G'"${keys}m=$(( i + 4096 < ${#data} ? 1 : 0 ));${data:i:4096}"$'\e\\'
    keys='q=2,'
    i=$((i + 4096))
  done
  printf '%s' "$send"
}

# Every cell of the card at rest, built once from the generated brand data.
voco_ui_art_build() {
  [[ "$VOCO_UI_ART_BUILT" != true ]] || return 0
  local card=$'\e[48;2;'"$VOCO_UI_CARD"'m ' edge=$'\e[38;2;'"$VOCO_UI_CARD"';49m' r x cell glyph line
  local -a mic=()
  VOCO_UI_CELLS=() VOCO_UI_TOP_CELLS=() VOCO_UI_BOTTOM_CELLS=() VOCO_UI_WM_LIT=() VOCO_UI_WM_GLOW=()
  if [[ "$VOCO_UI_MIC_MODE" == octant || "$VOCO_UI_MIC_MODE" == sextant || "$VOCO_UI_MIC_MODE" == quadrant ]]; then
    # Each cell: its symbol, then its foreground and background palette indices.
    local -n mosaic="VOCO_UI_MOSAIC_${VOCO_UI_MIC_MODE^^}"
    for cell in "${mosaic[@]}"; do
      glyph=${cell%????}
      if [[ "$glyph" == ' ' ]]; then
        mic+=($'\e[48;2;'"${VOCO_UI_PALETTE[16#${cell: -2}]}"'m ')
      else
        mic+=($'\e[38;2;'"${VOCO_UI_PALETTE[16#${cell: -4:2}]}"';48;2;'"${VOCO_UI_PALETTE[16#${cell: -2}]}"'m'"$glyph")
      fi
    done
  else
    # Graphite, under the image the card places over these cells.
    for ((x=0; x<VOCO_UI_CARD_ROWS*14; x++)); do mic+=("$card"); done
    [[ "$VOCO_UI_MIC_MODE" != kitty ]] || voco_ui_image_build
  fi
  VOCO_UI_MIC_ROWS=''
  for ((r=0; r<VOCO_UI_CARD_ROWS; r++)); do
    line=''
    for ((x=0; x<VOCO_UI_CARD_WIDTH; x++)); do
      if (( x >= 2 && x < 16 )); then
        VOCO_UI_CELLS+=("${mic[r*14+x-2]}")
        line+=${mic[r*14+x-2]}
      else
        VOCO_UI_CELLS+=("$card")
      fi
    done
    VOCO_UI_MIC_ROWS+=$line$'\n'
  done
  # Rounded edges: the card begins and ends half a cell in, on any background.
  for ((x=0; x<VOCO_UI_CARD_WIDTH; x++)); do
    if (( x == 0 )); then VOCO_UI_TOP_CELLS+=("${edge}▗") VOCO_UI_BOTTOM_CELLS+=("${edge}▝")
    elif (( x == VOCO_UI_CARD_WIDTH - 1 )); then VOCO_UI_TOP_CELLS+=("${edge}▖") VOCO_UI_BOTTOM_CELLS+=("${edge}▘")
    else VOCO_UI_TOP_CELLS+=("${edge}▄") VOCO_UI_BOTTOM_CELLS+=("${edge}▀"); fi
  done
  for ((r=0; r<5; r++)); do
    VOCO_UI_WM_LIT+=($'\e[38;2;'"${VOCO_UI_WORDMARK[2*r]}"';48;2;'"${VOCO_UI_WORDMARK[2*r+1]}"'m▀')
    VOCO_UI_WM_GLOW+=($'\e[38;2;'"${VOCO_UI_WORDMARK_SHINE[0]}"';48;2;'"${VOCO_UI_WORDMARK_SHINE[1]}"'m▀')
  done
  VOCO_UI_SWEEP_GLOW=$'\e[48;2;'"${VOCO_UI_SWEEP[0]}"'m '
  VOCO_UI_SWEEP_BAR=$'\e[48;2;'"${VOCO_UI_SWEEP[1]}"'m '
  VOCO_UI_SWEEP_TOP=$'\e[38;2;'"${VOCO_UI_SWEEP[1]}"';49m▄'
  VOCO_UI_SWEEP_BOTTOM=$'\e[38;2;'"${VOCO_UI_SWEEP[1]}"';49m▀'
  VOCO_UI_ART_BUILT=true
}

# Write TEXT's first COUNT characters into the caller's row from column FROM.
voco_ui_card_text() {
  local text="$1" color="$2" from="$3" count="$4" i
  for ((i=0; i<count && i<${#text}; i++)); do
    row[from+i]=$'\e[38;2;'"$color"';48;2;'"$VOCO_UI_CARD"'m'"${text:i:1}"
  done
}

# The card's 13 lines at T milliseconds into the intro, with the shine S
# milliseconds in, or no shine when S is negative.
voco_ui_card_at() {
  local t="$1" s="$2" IFS=
  local W=$VOCO_UI_CARD_WIDTH R=$VOCO_UI_ART_RIGHT sweep=$VOCO_UI_CARD_WIDTH band=-100 out='' line
  local r gr i c x start p offset glyph label="v${VERSION:-}" count
  local -a row
  (( t >= VOCO_UI_SWEEP_MS )) || sweep=$(( t * (W + 1) / VOCO_UI_SWEEP_MS ))
  # The shine is a slanted band, three columns wide, crossing the wordmark.
  (( s < 0 )) || band=$(( -8 + s * 51 / VOCO_UI_SHINE_MS ))
  line="${VOCO_UI_TOP_CELLS[*]:0:sweep}"
  (( sweep >= W )) || line+="$VOCO_UI_SWEEP_TOP"
  out+=$'\r\e[K  '"$line"$'\e[0m\n'
  for ((r=0; r<VOCO_UI_CARD_ROWS; r++)); do
    row=("${VOCO_UI_CELLS[@]:r*W:W}")
    if (( r == 0 && t >= VOCO_UI_VERSION_AT )); then
      voco_ui_card_text "$label" "$VOCO_UI_TEXT_VERSION" $((R + 37 - ${#label})) "${#label}"
    elif (( r >= 2 && r <= 6 )); then
      gr=$((r - 2))
      for ((i=0; i<4; i++)); do
        start=$((VOCO_UI_GLIDE_AT + i * VOCO_UI_GLIDE_STEP))
        (( t >= start )) || continue
        p=$(( (t - start) * 20 / VOCO_UI_GLIDE_MS )); (( p <= 20 )) || p=20
        offset=$(( VOCO_UI_GLIDE_COLUMNS * (1000 - VOCO_UI_EASE[p]) / 1000 ))
        glyph=${VOCO_UI_GLYPHS[gr*4+i]}
        for ((c=0; c<8; c++)); do
          [[ "${glyph:c:1}" == '█' ]] || continue
          x=$((R + i * 9 + offset + c))
          (( x < W - 2 )) || continue
          if (( x - R >= band + 4 - gr && x - R < band + 7 - gr )); then row[x]=${VOCO_UI_WM_GLOW[gr]}
          else row[x]=${VOCO_UI_WM_LIT[gr]}; fi
        done
      done
    elif (( r == 8 && t > VOCO_UI_BRAND_AT )); then
      count=$(( (t - VOCO_UI_BRAND_AT) / 10 ))
      voco_ui_card_text "$VOCO_UI_BRAND_LINE" "$VOCO_UI_TEXT_BRAND" "$R" "$count"
    elif (( r == 9 && t > VOCO_UI_TODAY_AT )); then
      count=$(( (t - VOCO_UI_TODAY_AT) / 10 ))
      voco_ui_card_text "$VOCO_UI_TODAY_LINE" "$VOCO_UI_TEXT_TODAY" "$R" "$count"
    fi
    if (( sweep < W )); then
      (( sweep < 1 )) || row[sweep-1]=$VOCO_UI_SWEEP_GLOW
      line="${row[*]:0:sweep}$VOCO_UI_SWEEP_BAR"
    else
      line="${row[*]}"
    fi
    out+=$'\r\e[K  '"$line"$'\e[0m\n'
  done
  line="${VOCO_UI_BOTTOM_CELLS[*]:0:sweep}"
  (( sweep >= W )) || line+="$VOCO_UI_SWEEP_BOTTOM"
  out+=$'\r\e[K  '"$line"$'\e[0m\n'
  # The image covers the microphone cells the sweep has passed.
  if [[ "$VOCO_UI_MIC_MODE" == kitty ]]; then
    count=$(( sweep >= W ? 14 : sweep - 3 ))
    (( count <= 14 )) || count=14
    (( count < 1 )) || out+=${VOCO_UI_PLACE[count]}
  fi
  VOCO_UI_CARD_TEXT=$out
}

# The card for now: its final state once the intro and any shine are done.
voco_ui_card() {
  local t=$VOCO_UI_INTRO_MS s=-1
  if [[ "$VOCO_UI_NO_MOTION" != true ]]; then
    voco_ui_now_ms
    if (( VOCO_UI_INTRO_START > 0 && VOCO_UI_NOW - VOCO_UI_INTRO_START < VOCO_UI_INTRO_MS )); then
      t=$((VOCO_UI_NOW - VOCO_UI_INTRO_START))
    fi
    if (( t >= VOCO_UI_SHINE_AT && t < VOCO_UI_SHINE_AT + VOCO_UI_SHINE_MS )); then
      s=$((t - VOCO_UI_SHINE_AT))
    elif (( VOCO_UI_SHINE_START > 0 && VOCO_UI_NOW - VOCO_UI_SHINE_START < VOCO_UI_SHINE_MS )); then
      s=$((VOCO_UI_NOW - VOCO_UI_SHINE_START))
    fi
  fi
  if (( t >= VOCO_UI_INTRO_MS && s < 0 )) && [[ -n "$VOCO_UI_CARD_FINAL" ]]; then
    VOCO_UI_CARD_TEXT=$VOCO_UI_CARD_FINAL
    return
  fi
  voco_ui_card_at "$t" "$s"
  if (( t >= VOCO_UI_INTRO_MS && s < 0 )); then VOCO_UI_CARD_FINAL=$VOCO_UI_CARD_TEXT; fi
}

# True while the intro or a shine is still moving.
voco_ui_animating() {
  [[ "$VOCO_UI_ART" == true && "$VOCO_UI_NO_MOTION" != true ]] || return 1
  voco_ui_now_ms
  (( (VOCO_UI_INTRO_START > 0 && VOCO_UI_NOW - VOCO_UI_INTRO_START < VOCO_UI_INTRO_MS) ||
     (VOCO_UI_SHINE_START > 0 && VOCO_UI_NOW - VOCO_UI_SHINE_START < VOCO_UI_SHINE_MS) ))
}

voco_ui_init() {
  voco_ui_configure
  [[ "$VOCO_TERMINAL_MOTION" == true && -z "$VOCO_UI_TIMER_FD" ]] || return 0
  # An owned, unlinked FIFO gives read -t a timer without a sleep subprocess. It
  # lives in its own private directory, so the intro can play before downloads.
  local folder
  folder=$(mktemp -d) || return 0
  if mkfifo -m 600 "$folder/ui-timer"; then exec {VOCO_UI_TIMER_FD}<>"$folder/ui-timer"; fi
  rm -rf -- "$folder"
}

voco_ui_size() {
  local bytes="$1" unit=KiB divisor=1024
  if (( bytes >= 1048576 )); then unit=MiB; divisor=1048576; fi
  printf -v VOCO_UI_SIZE '%d.%d %s' "$((bytes/divisor))" "$((bytes%divisor*10/divisor))" "$unit"
}

# One bounded canvas is shared by every normal installation stage. With
# "progress" as the fourth argument a resting card stays as it is on screen and
# only the progress lines are drawn again.
voco_ui_frame() {
  [[ "$VOCO_TERMINAL_MOTION" == true ]] || return 0
  local title="$1" detail="$2" mark="${3:-—}" card="${4:-full}" width i color
  local stages='' frame='' part='' symbol line2='' rule='────────────────────────────────────────────────────────'
  local -a labels=(Check Download Verify Install)
  width=$((${VOCO_TERMINAL_COLUMNS:-80}-5))
  if (( ${#detail} > width )); then
    local first="${detail:0:width}"
    if [[ "$first" == *' '* ]]; then first="${first% *}"; fi
    line2="${detail:${#first}}"; line2="${line2# }"; detail="$first"
  fi
  for i in 0 1 2 3; do
    symbol='○'; color="$VOCO_UI_MUTED"
    if (( i < VOCO_UI_STAGE )); then symbol='✓'; color="$VOCO_UI_COMPLETE"
    elif (( i == VOCO_UI_STAGE )); then symbol='›'; color="$VOCO_UI_ACTIVE"; fi
    stages+="${color}${symbol} ${labels[i]}${NC}   "
  done
  if [[ "$VOCO_UI_ART" == true && "$card" == progress ]] && ! voco_ui_animating; then
    printf -v frame '\033[%dA' "$VOCO_UI_PROGRESS_LINES"
  elif [[ "$VOCO_UI_ART" == true ]]; then
    printf -v frame '\033[%dA' "$VOCO_UI_LINES"
    voco_ui_card
    frame+="$VOCO_UI_CARD_TEXT"
  else
    printf -v frame '\033[%dA' "$VOCO_UI_LINES"
    printf -v part '\r\033[K  %bV O C O%b  v%s\n\r\033[K  The voice layer for Linux. Today: private dictation.\n' "$VOCO_UI_SILVER" "$NC" "${VERSION:-}"
    frame+="$part"
  fi
  color="$VOCO_UI_SILVER"
  [[ "$mark" != '✓' ]] || color="$VOCO_UI_COMPLETE"
  printf -v part '\r\033[K\n\r\033[K  %b%s%b\n\r\033[K  %s\n\r\033[K  %s\n\r\033[K  %s\n\r\033[K  %s\n\r\033[K  %b\n\r\033[K  %s\n' \
    "$color" "$mark" "$NC" "${title:0:width}" "$detail" "${line2:0:width}" "${rule:0:width}" "$stages" "${VOCO_UI_NOTE:0:width}"
  frame+="$part"
  # A terminating sweep may stop while building the frame, but must never leave
  # the cursor between rows. Bash runs the termination trap after this builtin.
  printf '%s' "$frame"
}

voco_ui_begin() {
  [[ "$VOCO_TERMINAL_MOTION" == true ]] || return 0
  voco_ui_pause
  if [[ "$VOCO_UI_OPEN" != true ]]; then
    local line
    for ((line=0;line<VOCO_UI_LINES;line++)); do printf '\n'; done
    VOCO_UI_OPEN=true
    # The intro plays once, the first time the canvas opens.
    if [[ "$VOCO_UI_ART" == true && "$VOCO_UI_NO_MOTION" != true ]] && (( VOCO_UI_INTRO_START == 0 )); then
      voco_ui_now_ms
      VOCO_UI_INTRO_START=$VOCO_UI_NOW
    fi
  fi
  VOCO_UI_TITLE="$1"
  voco_ui_frame "$1" "${2:-}" "${3:-—}"
}

# Keep the intro or a shine moving after a frame: about 30 frames a second, in the
# background, until both are done. Every foreground frame pauses it first.
voco_ui_animate() {
  [[ -n "$VOCO_UI_TIMER_FD" ]] && voco_ui_animating || return 0
  (
    trap - EXIT
    trap 'exit 0' TERM INT
    while voco_ui_animating; do
      voco_ui_frame "$1" "$2" "$3"
      IFS= read -r -t .033 -u "$VOCO_UI_TIMER_FD" _ || true
    done
    voco_ui_frame "$1" "$2" "$3"
  ) &
  VOCO_UI_PID=$!
}

# End any intro or shine now, so the next frame shows the card at rest. The last
# frame of a fast install uses this instead of waiting for the intro.
voco_ui_settle() {
  voco_ui_pause
  VOCO_UI_INTRO_START=1 VOCO_UI_SHINE_START=0
}

# A foreground frame that leaves any intro or shine still moving.
voco_ui_show() {
  voco_ui_pause
  voco_ui_frame "$1" "$2" "${3:-—}"
  voco_ui_animate "$1" "$2" "${3:-—}"
}

voco_ui_stage() {
  VOCO_UI_STAGE="$1"
  if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then
    if [[ -n "$VOCO_UI_TIMER_FD" ]]; then voco_ui_sweep "$2" "${3:-}"; else voco_ui_begin "$2" "${3:-}"; fi
  else
    dim "$2"
    [[ -z "${3:-}" ]] || dim "$3"
  fi
}

voco_ui_sweep() {
  voco_ui_begin "$1" "$2"
  [[ "$VOCO_TERMINAL_MOTION" == true && "$VOCO_UI_NO_MOTION" != true ]] || return 0
  voco_ui_now_ms
  # Each stage lights the wordmark once, unless the intro is still playing.
  if (( VOCO_UI_INTRO_START == 0 || VOCO_UI_NOW - VOCO_UI_INTRO_START >= VOCO_UI_INTRO_MS )); then
    VOCO_UI_SHINE_START=$VOCO_UI_NOW
  fi
  voco_ui_animate "$1" "$2" '—'
}

voco_ui_pause() {
  if [[ -n "$VOCO_UI_PID" ]]; then
    kill "$VOCO_UI_PID" 2>/dev/null || true
    wait "$VOCO_UI_PID" 2>/dev/null || true
    VOCO_UI_PID=""
  fi
}

voco_ui_release() {
  voco_ui_pause
  if [[ "$VOCO_UI_OPEN" == true ]]; then
    # The image would stay where the canvas was, so it goes first.
    [[ "$VOCO_UI_ART" != true ]] || printf '%s' "$VOCO_UI_UNPLACE"
    printf '\033[%dA' "$VOCO_UI_LINES"
    local line
    for ((line=0;line<VOCO_UI_LINES;line++)); do printf '\r\033[K\n'; done
    printf '\033[%dA\r' "$VOCO_UI_LINES"
  fi
  VOCO_UI_OPEN=false
}

voco_ui_download_observer() {
  trap - EXIT
  trap 'exit 0' TERM INT
  local destination="$1" start="$2" bytes=0 now delta rate elapsed mark='' detail='' sampled=0 card=full
  local glyphs=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █) value
  VOCO_UI_LAST_BYTES=0
  VOCO_UI_LAST_TIME=${EPOCHREALTIME/./}
  voco_ui_now_ms
  # The download lights the wordmark once, unless the intro is still playing.
  if [[ "$VOCO_UI_NO_MOTION" != true ]] && (( VOCO_UI_INTRO_START == 0 || VOCO_UI_NOW - VOCO_UI_INTRO_START >= VOCO_UI_INTRO_MS )); then
    VOCO_UI_SHINE_START=$VOCO_UI_NOW
  fi
  while :; do
    now=${EPOCHREALTIME/./}
    # Sample at 4 Hz, whatever the frame rate; only shell builtins run between samples.
    if (( now - sampled >= 250000 )); then
      sampled=$now
      bytes=$(stat -c %s -- "$destination" 2>/dev/null || printf '0')
      now=${EPOCHREALTIME/./}
      delta=$((now-VOCO_UI_LAST_TIME))
      rate=0
      if (( delta > 0 && bytes >= VOCO_UI_LAST_BYTES )); then rate=$(((bytes-VOCO_UI_LAST_BYTES)*1000000/delta)); fi
      VOCO_UI_LAST_BYTES=$bytes; VOCO_UI_LAST_TIME=$now
      VOCO_UI_RATES=("${VOCO_UI_RATES[@]:1}" "$rate")
      elapsed=$((SECONDS-start))
      voco_ui_size "$bytes"; detail="$VOCO_UI_SIZE received"
      if (( elapsed > 0 )); then
        voco_ui_size "$((bytes/elapsed))"; detail+=" · $VOCO_UI_SIZE/s avg"
      fi
      mark=''
      if [[ "$VOCO_UI_NO_MOTION" == true ]]; then mark='↓'; else
        # A fixed logarithmic scale keeps rates comparable without needing a known total.
        for value in "${VOCO_UI_RATES[@]}"; do
          if (( value == 0 )); then mark+='· '; else
            value=$((value/131072)); local level=0
            while (( value > 1 && level < 7 )); do value=$((value/2)); level=$((level+1)); done
            mark+="${glyphs[level]} "
          fi
        done
      fi
    fi
    if voco_ui_animating; then
      voco_ui_frame 'Bringing VOCO to your desktop.' "$detail" "$mark"
      card=full
      IFS= read -r -t .033 -u "$VOCO_UI_TIMER_FD" _ || true
    else
      # Once the card has drawn at rest, it stays on screen untouched.
      voco_ui_frame 'Bringing VOCO to your desktop.' "$detail" "$mark" "$card"
      card=progress
      IFS= read -r -t .25 -u "$VOCO_UI_TIMER_FD" _ || true
    fi
  done
}

voco_ui_close() {
  voco_ui_pause
  # An interrupted probe leaves echo off: give the terminal its settings back.
  if [[ -n "$VOCO_UI_PROBE_TTY" ]]; then
    stty "$VOCO_UI_PROBE_TTY" 2>/dev/null < /dev/tty || true
    VOCO_UI_PROBE_TTY=''
  fi
  # An APT display stopped mid-write can leave an escape sequence open: ST ends it.
  [[ "$VOCO_UI_APT_DRAWING" != true ]] || printf '\033\\'
  if [[ -n "$VOCO_UI_TIMER_FD" ]]; then exec {VOCO_UI_TIMER_FD}>&-; VOCO_UI_TIMER_FD=""; fi
}

voco_run_apt() {
  local result=0
  local wrapper='exec 3>&1 1>&2; exec apt-get -q=2 -o APT::Status-Fd=3 -o Dpkg::Use-Pty=0 install -y -- "$@"'
  local output_fd fifo="$VOCO_DOWNLOAD_DIR/apt-output"
  local -a statuses
  # Minimal systems use APT's own presentation until Python is installed. There
  # is never a download/install of a framework just to display progress.
  if [[ "$VOCO_TERMINAL_MOTION" != true || ! -t 0 ]] || ! command -v python3 >/dev/null 2>&1; then
    voco_ui_release
    sudo apt-get install -y -- "$@"
    return $?
  fi
  if ! sudo -n -v >/dev/null 2>&1; then
    voco_ui_release
    dim 'VOCO · Ubuntu needs your permission to install.'
    sudo -v || return $?
  fi
  # Respect sudo policies that permit apt-get but not an exec wrapper. Do not ask
  # owners to broaden permissions just for presentation.
  if ! sudo -n -l -- sh -c "$wrapper" voco-apt "$@" >/dev/null 2>&1; then
    voco_ui_release
    sudo apt-get install -y -- "$@"
    return $?
  fi
  voco_ui_release
  # The APT renderer owns and clears its canvas, including prompt handoffs.
  [[ -n "$VOCO_INSTALL_LOG" ]] || VOCO_INSTALL_LOG=$(mktemp "${TMPDIR:-/tmp}/voco-install.XXXXXX.log")
  mkfifo -m 600 "$fifo"
  exec {output_fd}<>"$fifo"
  rm -f -- "$fifo"
  # APT marks its status descriptor close-on-exec before dpkg starts. A dedicated
  # fd is essential: using stdout would close maintainer-script output. Create fd
  # 3 AFTER sudo, with a fixed wrapper and separate arguments (never interpolation).
  VOCO_UI_APT_DRAWING=true
  if sudo sh -c "$wrapper" voco-apt "$@" 2>&"$output_fd" |
      voco_apt_display "$VOCO_INSTALL_LOG" "$VOCO_UI_NO_MOTION" separate "${VERSION:-}" "$VOCO_UI_LINES" \
        "$VOCO_UI_MIC_ROWS" "${VOCO_UI_PLACE[14]:-}" "$VOCO_UI_UNPLACE" 4<&"$output_fd"; then
    result=0
  else
    statuses=("${PIPESTATUS[@]}")
    result=${statuses[0]}
    (( result != 0 )) || result=${statuses[1]}
  fi
  VOCO_UI_APT_DRAWING=false
  exec {output_fd}>&-
  voco_ui_release
  if (( result != 0 )); then
    VOCO_KEEP_LOG=true
    dim "Installation details: $VOCO_INSTALL_LOG"
  fi
  return "$result"
}

voco_run_dnf() {
  # DNF keeps its own presentation, prompts included; VOCO only hands it a
  # clear terminal and says who is asking for the password.
  voco_ui_release
  if ! sudo -n -v >/dev/null 2>&1; then
    dim 'VOCO · Fedora needs your permission to install.'
  fi
  sudo dnf install -y -- "$@"
}

voco_apt_display() {
  local code
  IFS= read -r -d '' code <<'VOCO_APT_PY' || true
#!/usr/bin/env python3
"""Observe separate APT status/output streams without changing terminal input.

APT closes its progress descriptor before invoking dpkg. The caller creates that
separate descriptor after sudo; package-script stdout/stderr stay intact. Unknown
output and non-newline prompts suspend presentation and remain visible.
"""
import contextlib
import os
import re
import select
import shutil
import sys
import time

# BEGIN GENERATED INSTALLER BRAND
BRAND_ROWS = [['██    ██', ' ██████ ', ' ██████ ', ' ██████ '], ['██    ██', '██    ██', '██      ', '██    ██'], [' ██  ██ ', '██    ██', '██      ', '██    ██'], ['  ████  ', '██    ██', '██      ', '██    ██'], ['   ██   ', ' ██████ ', ' ██████ ', ' ██████ ']]
BRAND_COLORS = {'silver': '\x1b[38;2;199;204;212m', 'muted': '\x1b[38;2;122;128;138m', 'complete': '\x1b[38;2;165;217;178m', 'active': '\x1b[38;2;239;206;131m'}
BRAND_CARD = '17;19;24'
BRAND_WORDMARK = ['244;246;249', '233;236;240', '222;225;230', '210;214;221', '199;204;212', '188;193;202', '177;182;192', '165;172;181', '154;161;171', '143;150;161']
BRAND_WORDMARK_SHINE = ['255;255;255', '238;241;245']
BRAND_TEXT = {'brand': '199;204;212', 'today': '174;181;191', 'version': '140;146;156'}
# END GENERATED INSTALLER BRAND

ROUTINE = re.compile(
    r'^(?:Reading package lists|Building dependency tree|Reading state information|'
    r'Note, selecting |The following (?:additional packages|NEW packages|packages will be upgraded)|'
    r'Suggested packages:|Recommended packages:|'
    r'\d+ upgraded, \d+ newly installed,|Need to get |After this operation, |'
    r'Get:\d+ |Fetched |Selecting previously unselected package |'
    r'\(Reading database|Preparing to unpack |Unpacking |Setting up |Processing triggers for |'
    r'debconf: delaying package configuration, since apt-utils is not installed$)'
)
STATUS = re.compile(r'^(pmstatus|dlstatus):([^:]*):([0-9]+(?:\.[0-9]+)?):(.*)$')
# install-ui.sh's art canvas: the card's size and layout, and its shine.
CARD_WIDTH = 58
CARD_ROWS = 11
ART_RIGHT = 19
SHINE_MS = 280
ART_LINES = CARD_ROWS + 2 + 8


def card_lines(version, mic, shine_ms=-1):
    """The card at rest, exactly as install-ui.sh draws it: with the microphone
    rows install-ui.sh passes in, and the shine shine_ms milliseconds in, or
    none when negative."""
    card = f'\033[48;2;{BRAND_CARD}m '
    edge = f'\033[38;2;{BRAND_CARD};49m'
    band = -100 if shine_ms < 0 else -8 + shine_ms * 51 // SHINE_MS
    lines = [edge + '▗' + (edge + '▄') * (CARD_WIDTH - 2) + edge + '▖']
    for r in range(CARD_ROWS):
        row = [card] * CARD_WIDTH
        # The microphone's fourteen cells, as one string.
        if len(mic) == CARD_ROWS:
            row[2:16] = [mic[r]] + [''] * 13

        def text(value, color, start):
            for i, char in enumerate(value):
                row[start + i] = f'\033[38;2;{color};48;2;{BRAND_CARD}m{char}'
        if r == 0:
            label = 'v' + version
            text(label, BRAND_TEXT['version'], ART_RIGHT + 37 - len(label))
        elif 2 <= r <= 6:
            glyph_row = r - 2
            for letter, glyph in enumerate(BRAND_ROWS[glyph_row]):
                for column, char in enumerate(glyph):
                    x = ART_RIGHT + letter * 9 + column
                    if char != '█' or x >= CARD_WIDTH - 2:
                        continue
                    lit = (BRAND_WORDMARK_SHINE if band + 4 - glyph_row <= x - ART_RIGHT < band + 7 - glyph_row
                           else BRAND_WORDMARK[2 * glyph_row:2 * glyph_row + 2])
                    row[x] = f'\033[38;2;{lit[0]};48;2;{lit[1]}m▀'
        elif r == 8:
            text('The voice layer for Linux.', BRAND_TEXT['brand'], ART_RIGHT)
        elif r == 9:
            text('Today: private dictation.', BRAND_TEXT['today'], ART_RIGHT)
        lines.append(''.join(row))
    lines.append(edge + '▝' + (edge + '▀') * (CARD_WIDTH - 2) + edge + '▘')
    return [line + '\033[0m' for line in lines]


def main():
    path, no_motion = sys.argv[1:3]
    separate = len(sys.argv) > 3 and sys.argv[3] == 'separate'
    version = sys.argv[4] if len(sys.argv) > 4 else ''
    # The installer passes its canvas height, so both renderers agree on it, then
    # the card's microphone rows and the commands that place its image after the
    # card and take it away.
    canvas_lines = ART_LINES if len(sys.argv) > 5 and sys.argv[5] == str(ART_LINES) else 10
    mic = sys.argv[6].split('\n')[:CARD_ROWS] if len(sys.argv) > 6 else []
    place = sys.argv[7] if len(sys.argv) > 7 else ''
    unplace = sys.argv[8] if len(sys.argv) > 8 else ''
    output_fd = 4 if separate else 0
    streams = [0, 4] if separate else [0]
    pending = {fd: b'' for fd in streams}
    passthrough = False
    detail = 'Resolving package dependencies.'
    mark = '—'
    start = time.monotonic()
    last_frame = 0.0
    dirty = True
    partial_since = None
    finished = False
    canvas_open = False
    card_drawn = False

    def write(data):
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()

    def release():
        nonlocal canvas_open, card_drawn
        if canvas_open:
            # The image would stay where the canvas was, so it goes first.
            up = f'\033[{canvas_lines}A'.encode()
            write(unplace.encode() + up + b'\r\033[K\n' * canvas_lines + up + b'\r')
            canvas_open = False
            card_drawn = False

    def pass_output():
        nonlocal passthrough
        release()
        passthrough = True

    def shining(now):
        return no_motion != 'true' and canvas_lines == ART_LINES and now - start < SHINE_MS / 1000

    def frame(now):
        nonlocal last_frame, dirty, canvas_open, card_drawn
        width = max(10, shutil.get_terminal_size((80, 24)).columns - 5)
        reset = '\033[0m'
        if not canvas_open:
            write(b'\n' * canvas_lines)
            canvas_open = True
        stages = BRAND_COLORS['complete'] + '✓ Check   ✓ Download   ✓ Verify   ' + BRAND_COLORS['active'] + '› Install' + reset
        progress = ['', BRAND_COLORS['silver'] + mark + reset,
                    'Setting up VOCO.', detail[:width], '',
                    '────────────────────────────────────────────────────────'[:width],
                    stages, '']
        drawn = lambda lines: ''.join('\r\033[K  ' + line + '\n' for line in lines)
        if canvas_lines == ART_LINES:
            if card_drawn and not shining(now):
                # A card at rest stays on screen; only the progress lines change.
                text, up = drawn(progress), len(progress)
            else:
                shine = int((now - start) * 1000) if shining(now) else -1
                text, up = drawn(card_lines(version, mic, shine)) + place + drawn(progress), canvas_lines
                card_drawn = shine < 0
        else:
            heading = [BRAND_COLORS['silver'] + 'V O C O' + reset + '  v' + version, 'The voice layer for Linux. Today: private dictation.']
            text, up = drawn(heading + progress), canvas_lines
        write((f'\033[{up}A' + text).encode())
        last_frame = now
        dirty = False

    def status(raw):
        nonlocal passthrough, detail, mark, dirty
        text = raw.decode('utf-8', 'replace').rstrip('\r\n')
        match = STATUS.fullmatch(text)
        if match:
            kind, package, percent, description = match.groups()
            amount = float(percent)
            if not 0 <= amount <= 100:
                pass_output()
            elif not passthrough:
                # APT's phase progress is never whole-installer progress.
                detail = ('Desktop dependencies' if kind == 'dlstatus' else 'Package setup') + f' · {int(amount)}%'
                mark = '↓' if kind == 'dlstatus' else ' '.join('●' if amount >= step else '○' for step in (25, 50, 75, 100))
                dirty = True
            return True
        if text.startswith(('pmconffile:', 'media-change:', 'pmerror:')):
            pass_output()
            if text.startswith(('pmerror:', 'media-change:')):
                write(('\n' + text.split(':', 3)[-1] + '\n').encode())
            return True
        return False

    def line(fd, raw):
        nonlocal passthrough
        if (fd == 0 or not separate) and status(raw):
            return
        if separate and fd == 0:
            # Unknown protocol data belongs in the log; raw output remains visible.
            pass_output()
            return
        text = raw.decode('utf-8', 'replace').rstrip('\r\n')
        if not passthrough and (not text.strip() or ROUTINE.match(text)):
            return
        pass_output()
        write(raw)

    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW)
        log_file = os.fdopen(descriptor, 'ab', buffering=0)
    except OSError:
        log_file = None
        pass_output()
        write(b'Could not save installation details; continuing with terminal output.\n')
    with log_file if log_file is not None else contextlib.nullcontext() as log:
        while True:
            now = time.monotonic()
            # About 30 frames a second until the card rests, otherwise 10 at most.
            moving = canvas_lines == ART_LINES and (shining(now) or (canvas_open and not card_drawn))
            interval = .033 if moving else .1
            if not passthrough and (dirty or moving) and now - last_frame >= interval:
                frame(now)
            timeout = None
            if not passthrough and (dirty or moving):
                timeout = max(0, interval - (now - last_frame))
            if partial_since is not None:
                remaining = max(0, .05 - (now - partial_since))
                timeout = remaining if timeout is None else min(timeout, remaining)
            readable, _, _ = select.select(streams, [], [], 0 if finished else timeout)
            if finished and not readable:
                for fd, rest in pending.items():
                    if rest:
                        line(fd, rest)
                release()
                return
            for fd in readable:
                chunk = os.read(fd, 65536)
                if not chunk:
                    streams.remove(fd)
                    if fd == 0:
                        finished = True
                    continue
                if log is not None:
                    try:
                        log.write(chunk)
                    except OSError:
                        log = None
                        pass_output()
                        write(b'Could not save installation details; continuing with terminal output.\n')
                pending[fd] += chunk
                while b'\n' in pending[fd]:
                    raw, pending[fd] = pending[fd].split(b'\n', 1)
                    line(fd, raw + b'\n')
                if fd == output_fd:
                    if not pending[fd]:
                        partial_since = None
                    elif partial_since is None:
                        partial_since = time.monotonic()
                elif len(pending[fd]) > 8192:
                    pass_output()
                    pending[fd] = b''
            rest = pending[output_fd]
            if rest and (len(rest) > 8192 or (partial_since is not None and time.monotonic() - partial_since >= .05)):
                pass_output()
                write(rest)
                pending[output_fd] = b''
                partial_since = None


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(130)
VOCO_APT_PY
  python3 -I -c "$code" "$@"
}
# END EMBEDDED INSTALLER UI

# Download output is measured from bytes received, never simulated percentages.
DOWNLOAD_PID=""
CHECKSUM_DOWNLOAD_PID=""
SIGNATURE_DOWNLOAD_PID=""
VOCO_INSTALL_LOG=""
VOCO_KEEP_LOG=false
voco_download() {
  local label="$1" destination="$2" url="$3"
  local started=$SECONDS bytes elapsed detail result=0
  if [[ -z "$VOCO_INSTALL_LOG" ]]; then
    VOCO_INSTALL_LOG=$(mktemp "${TMPDIR:-/tmp}/voco-install.XXXXXX.log")
  fi
  # Suppress wget's per-chunk dot log; retain its response summary and errors.
  # Keep --continue: without it Fedora's wget2 restarts a failed transfer and
  # appends the whole file to the partial one.
  wget --no-verbose --continue --tries=3 --waitretry=2 --timeout=30 -O "$destination" "$url" >> "$VOCO_INSTALL_LOG" 2>&1 &
  DOWNLOAD_PID=$!
  if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then
    if [[ -z "$VOCO_UI_TIMER_FD" ]]; then voco_ui_init; fi
    voco_ui_begin 'Bringing VOCO to your desktop.' "$label" '↓'
    if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then
      # Inherit the log descriptor at fork, including the pre-trap shutdown window.
      {
        voco_ui_download_observer "$destination" "$started" &
        VOCO_UI_PID=$!
      } 2>> "$VOCO_INSTALL_LOG"
    fi
  else
    dim "$label"
  fi
  # No polling interval or animation duration is on the completion path.
  wait "$DOWNLOAD_PID" || result=$?
  DOWNLOAD_PID=""
  voco_ui_pause
  if (( result != 0 )); then
    voco_ui_release
    VOCO_KEEP_LOG=true
    warn "The download stopped."
    if (( result == 8 )); then
      dim "This release file is unavailable. Check the release page:"
      dim "https://github.com/sergiopesch/voco/releases/tag/${RELEASE_TAG}"
    else
      dim "Check your connection and run the installer again."
    fi
    dim "Details: ${VOCO_INSTALL_LOG}"
    return "$result"
  fi
  bytes=$(stat -c %s "$destination")
  voco_ui_size "$bytes"; detail=$VOCO_UI_SIZE
  elapsed=$((SECONDS - started))
  if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then
    voco_ui_frame 'Download complete.' "${detail} received · ${elapsed}s" '✓'
  else
    ok "${detail} received · ${elapsed}s"
  fi
}

voco_start_release_metadata_downloads() {
  [[ -n "$VOCO_INSTALL_LOG" ]] || VOCO_INSTALL_LOG=$(mktemp "${TMPDIR:-/tmp}/voco-install.XXXXXX.log")
  wget --no-verbose --tries=3 --waitretry=2 --timeout=30 -O "$CHECKSUM_FILE" "$CHECKSUMS_URL" >> "$VOCO_INSTALL_LOG" 2>&1 &
  CHECKSUM_DOWNLOAD_PID=$!
  wget --no-verbose --tries=3 --waitretry=2 --timeout=30 -O "$SIGNATURE_FILE" "$SIGNATURE_URL" >> "$VOCO_INSTALL_LOG" 2>&1 &
  SIGNATURE_DOWNLOAD_PID=$!
}

voco_finish_release_metadata_downloads() {
  local checksum_result=0 signature_result=0
  wait "$CHECKSUM_DOWNLOAD_PID" || checksum_result=$?
  CHECKSUM_DOWNLOAD_PID=""
  wait "$SIGNATURE_DOWNLOAD_PID" || signature_result=$?
  SIGNATURE_DOWNLOAD_PID=""
  if (( checksum_result != 0 || signature_result != 0 )); then
    VOCO_KEEP_LOG=true
    voco_ui_release
    warn 'Could not download signed release checksums. Nothing was installed.'
    dim "Details: $VOCO_INSTALL_LOG"
    return 1
  fi
}

voco_verify_release_signature() {
  local keyring="${VOCO_DOWNLOAD_DIR}/voco-release-keyring.gpg"
  local signature_status
  if ! printf '%s' "$VOCO_RELEASE_KEY_BASE64" | base64 --decode > "$keyring"; then
    err 'Could not load the trusted release key. Nothing was installed.'
  fi
  chmod 600 "$keyring"
  if ! signature_status="$(gpgv --quiet --status-fd 1 --keyring "$keyring" "$SIGNATURE_FILE" "$CHECKSUM_FILE" 2>> "$VOCO_INSTALL_LOG")"; then
    VOCO_KEEP_LOG=true
    err 'The release signature could not be verified. Nothing was installed.'
  fi
  if [[ "$signature_status" != *"[GNUPG:] VALIDSIG ${VOCO_RELEASE_KEY_FINGERPRINT} "* ]]; then
    VOCO_KEEP_LOG=true
    err 'The release signer does not match VOCO. Nothing was installed.'
  fi
  ok 'Publisher signature verified'
}

voco_launch_installed_app() {
  # Keep the caller's desktop environment. Do not guess another login/display,
  # activate through a stale service-manager environment, or launch a root GUI.
  /usr/bin/python3 -I - <<'PY_LAUNCH'
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


def skip(message):
    print(message)
    sys.exit(2)


owner = os.getuid()
if owner == 0 or owner != os.geteuid():
    skip("Open VOCO as your regular desktop user.")
if any(os.environ.get(key) for key in ("SSH_CONNECTION", "SSH_CLIENT", "SSH_TTY")):
    skip("Open VOCO in your local desktop session.")

try:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
    info = runtime.lstat()
    if (not runtime.is_absolute() or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != owner or stat.S_IMODE(info.st_mode) & 0o077):
        skip("Open VOCO from your desktop session.")
    session = os.environ.get("XDG_SESSION_TYPE", "")
    wayland = os.environ.get("WAYLAND_DISPLAY", "")
    display = os.environ.get("DISPLAY", "")
    if session == "wayland" or (not session and wayland):
        if not wayland:
            skip("Open VOCO from your Wayland desktop.")
        address = Path(wayland)
        if not address.is_absolute():
            if address.name != wayland:
                skip("Open VOCO from your Wayland desktop.")
            address = runtime / address
        info = address.lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != owner:
            skip("Open VOCO from your Wayland desktop.")
    elif session == "x11" or (not session and display):
        local = re.fullmatch(r"(?:unix)?:([0-9]+)(?:\.[0-9]+)?", display)
        if not local:
            skip("Open VOCO from your local X11 desktop.")
        x11_root = Path("/tmp/.X11-unix")
        info = (x11_root / ("X" + local[1])).lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid not in (0, owner):
            skip("Open VOCO from your local X11 desktop.")
    else:
        skip("Open VOCO from your desktop session.")
except OSError:
    skip("The desktop display is unavailable. Open VOCO from your desktop.")

app = "/usr/bin/voco"
try:
    process = subprocess.Popen([app], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
    try:
        result = process.wait(timeout=0.35)
    except subprocess.TimeoutExpired:
        result = 0  # Launch requested; this is not a claim of application readiness.
    if result != 0:
        raise OSError("Application exited during launch")
except OSError:
    print("VOCO did not open automatically. Run /usr/bin/voco from your desktop.")
    sys.exit(1)
# A successful early exit can mean an existing instance accepted presentation.
# Never retry an uncertain launch or create a second activation route.
PY_LAUNCH
}

voco_install_cleanup() {
  # A background child can receive TERM before resetting its inherited traps.
  # Only the original installer owns these paths and tracked process IDs.
  [[ "$BASHPID" == "$VOCO_INSTALL_OWNER_BASHPID" ]] || return 0
  voco_ui_close
  if [[ -n "$CHECKSUM_DOWNLOAD_PID" ]]; then
    kill "$CHECKSUM_DOWNLOAD_PID" 2>/dev/null || true
    wait "$CHECKSUM_DOWNLOAD_PID" 2>/dev/null || true
  fi
  if [[ -n "$SIGNATURE_DOWNLOAD_PID" ]]; then
    kill "$SIGNATURE_DOWNLOAD_PID" 2>/dev/null || true
    wait "$SIGNATURE_DOWNLOAD_PID" 2>/dev/null || true
  fi
  if [[ -n "$DOWNLOAD_PID" ]]; then
    kill "$DOWNLOAD_PID" 2>/dev/null || true
    wait "$DOWNLOAD_PID" 2>/dev/null || true
  fi
  if [[ -n "${VOCO_DOWNLOAD_DIR:-}" ]]; then rm -rf -- "${VOCO_DOWNLOAD_DIR}"; fi
  if [[ -n "$VOCO_INSTALL_LOG" && "$VOCO_KEEP_LOG" != true ]]; then rm -f -- "$VOCO_INSTALL_LOG"; fi
}
VOCO_INSTALL_OWNER_BASHPID=$BASHPID
trap voco_install_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ─── Header ─────────────────────────────────────────────
VOCO_TERMINAL_COLUMNS="$(tput cols 2>/dev/null || printf '80')"
VOCO_TERMINAL_ROWS="$(tput lines 2>/dev/null || printf '24')"
# The frame timer exists from the start, so the intro plays during the checks.
voco_ui_init
if [[ "$VOCO_TERMINAL_MOTION" != true ]]; then
  printf '\n  VOCO · v%s\n  The voice layer for Linux. Today: private dictation.\n\n' "$VERSION"
fi

# ─── Checks ─────────────────────────────────────────────
voco_ui_stage 0 'Getting your desktop ready.' 'Checking your system.'

if [[ "$(uname)" != "Linux" ]]; then
  err "VOCO only supports Linux. Detected: $(uname)"
fi

if ! voco_detect_package_manager; then
  err "VOCO installs with APT on Ubuntu and Debian, or with DNF on Fedora. Neither was found."
fi
# Each package manager names the architecture its own way.
if [[ "$VOCO_PACKAGE_MANAGER" == dnf ]]; then
  PACKAGE_NAME="voco-${VERSION}-1.x86_64.rpm"
  PACKAGE_URL="$RPM_URL"
  PACKAGE_TOOLS=(dnf rpm)
  if [[ "$(uname -m)" != "x86_64" ]]; then
    err "Only amd64 (x86_64) is supported. Detected: $(uname -m)"
  fi
else
  PACKAGE_NAME="voco_${VERSION}_amd64.deb"
  PACKAGE_URL="$DEB_URL"
  PACKAGE_TOOLS=(apt-get dpkg-query)
  if [[ "$(dpkg --print-architecture 2>/dev/null)" != "amd64" ]]; then
    err "Only amd64 (x86_64) is supported. Detected: $(dpkg --print-architecture 2>/dev/null || uname -m)"
  fi
fi

for prerequisite in wget sha256sum base64 gpgv stat sudo "${PACKAGE_TOOLS[@]}"; do
  command -v "$prerequisite" >/dev/null 2>&1 || err "$prerequisite is required before downloading VOCO."
done
# Stop before the download on a system VOCO can't run on.
voco_check_platform_floors || err "$VOCO_PLATFORM_ERROR"
ok "Linux · x86_64"

# APT or DNF resolves package dependencies in the install stage. Readiness is
# checked after installation, when helpers and services can actually be available.
dim "Desktop dependencies are checked during installation."

# ─── Download ───────────────────────────────────────────
voco_ui_stage 1 'Bringing VOCO to your desktop.' 'English speech recognition, on this computer.'

VOCO_DOWNLOAD_DIR=$(mktemp -d)
PACKAGE_FILE="${VOCO_DOWNLOAD_DIR}/${PACKAGE_NAME}"
CHECKSUM_FILE="${VOCO_DOWNLOAD_DIR}/voco_checksums.txt"
SIGNATURE_FILE="${CHECKSUM_FILE}.asc"
PACKAGE_CHECKSUM_FILE="${VOCO_DOWNLOAD_DIR}/${PACKAGE_NAME}.sha256"

dim "Includes English speech recognition. Speech stays on this computer."
voco_start_release_metadata_downloads
voco_download "VOCO v${VERSION}" "$PACKAGE_FILE" "$PACKAGE_URL" || exit 1
voco_ui_stage 2 'Checking your download.' 'Waiting for signed release checksums.'
if ! voco_finish_release_metadata_downloads; then
  exit 1
fi
voco_ui_sweep 'Checking your download.' 'Checking the publisher signature.'
voco_verify_release_signature
voco_ui_sweep 'Checking your download.' 'Checking the package checksum.'

if ! grep -F "  $(basename "$PACKAGE_FILE")" "$CHECKSUM_FILE" > "$PACKAGE_CHECKSUM_FILE"; then
  err "Could not find a checksum entry for $(basename "$PACKAGE_FILE")"
fi

if (cd "$VOCO_DOWNLOAD_DIR" && sha256sum --check "$(basename "$PACKAGE_CHECKSUM_FILE")" >/dev/null 2>&1); then
  voco_ui_pause
  if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then voco_ui_frame 'Your download checks out.' 'Package checksum verified.' '✓'; else ok "Package checksum verified"; fi
else
  voco_ui_release
  err "The download could not be verified. Run the installer again; nothing was installed."
fi

# ─── Install ────────────────────────────────────────────
voco_ui_stage 3 'Setting up VOCO.' 'Preparing the verified package.'

# Only this owned staging directory contains public release files. Let APT's
# unprivileged download user read the verified package without widening user dirs.
chmod 755 "$VOCO_DOWNLOAD_DIR"
chmod 644 "$PACKAGE_FILE"
if [[ "$VOCO_PACKAGE_MANAGER" == dnf ]]; then
  VOCO_INSTALL_PACKAGE=(voco_install_rpm_package "$PACKAGE_FILE" "${VERSION}-1" "x86_64")
else
  VOCO_INSTALL_PACKAGE=(voco_install_deb_package "$PACKAGE_FILE" "$VERSION" "amd64")
fi
if "${VOCO_INSTALL_PACKAGE[@]}"; then
  voco_ui_stage 3 'Finishing desktop setup.' 'VOCO is installed. Checking desktop integration.'
else
  err "Installation failed: ${VOCO_INSTALL_ERROR}"
fi

rm -rf "$VOCO_DOWNLOAD_DIR"
# Shown only, and decided before VOCO first starts and writes its settings. VOCO
# copies a legacy Voice config when it has none, and keeps the shortcut it finds.
config_base="${HOME}/.config"
# Match dirs::config_dir(): an XDG override must be absolute.
if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then config_base="$XDG_CONFIG_HOME"; fi
HOTKEY="Alt+D"
for saved_config in "${config_base}/voco/config.json" "${config_base}/voice/config.json"; do
  if [[ -e "$saved_config" || -L "$saved_config" ]]; then HOTKEY="unchanged"; fi
done

if ! voco_verify_desktop_input; then
  warn "VOCO is installed. Desktop setup needs one more step."
  dim "${VOCO_INPUT_ERROR}"
  dim "Setup instructions: https://github.com/sergiopesch/voco/blob/master/docs/platform/README.md#wayland-paste-keys"
  dim "After setup, run: voco --check-desktop-input"
  if [[ -n "${VOCO_INSTALL_LOG:-}" ]]; then
    VOCO_KEEP_LOG=true
    dim "Details: $VOCO_INSTALL_LOG"
  fi
  exit 2
fi
ok "Desktop input prerequisites verified"

dim "Setting up VOCO's live panel for this desktop."
if VOCO_PANEL_DETAIL="$(/usr/bin/voco --setup-panel 2>&1)"; then
  dim "$VOCO_PANEL_DETAIL"
elif [[ "$VOCO_PANEL_DETAIL" == *'Panel enabled. Sign out and back in'* || "$VOCO_PANEL_DETAIL" == *'Panel update installed.'* ]]; then
  # Setup enabled the panel, or an upgrade left GNOME running the previous one.
  VOCO_UI_NOTE='Panel: sign out and back in to load it. Save your work first.'
  if [[ "$VOCO_TERMINAL_MOTION" != true ]]; then warn "$VOCO_UI_NOTE"; fi
else
  warn "$VOCO_PANEL_DETAIL"
  dim "You can check again in VOCO's setup or Help. The tray menu remains available."
fi

# ─── Done ───────────────────────────────────────────────
voco_ui_pause
if VOCO_LAUNCH_DETAIL="$(voco_launch_installed_app)"; then
  VOCO_NEXT_STEP="Opening VOCO → Start test → Finish test → Done."
else
  VOCO_NEXT_STEP="${VOCO_LAUNCH_DETAIL:-Open VOCO from your desktop.} Start test → Finish test → Done."
fi
VOCO_UI_STAGE=4
if [[ "$VOCO_TERMINAL_MOTION" == true ]]; then
  voco_ui_settle
  voco_ui_begin "Installed. Let's try your voice." "${VOCO_NEXT_STEP} Shortcut: ${HOTKEY}." '✓'
else
  ok "Installed. Let's try your voice."
  dim "$VOCO_NEXT_STEP"
  dim "Your shortcut is ${HOTKEY}. Change it in Shortcut."
fi
