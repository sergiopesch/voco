{
  "manifest_version": 3,
  "name": "VOCO Exact Field",
  "version": "0.1.0",
  "description": "Explicitly enable local dictation into the focused plain text field of this tab.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Enable VOCO in this tab"
  },
  "background": {
    "service_worker": "background.js"
  }
}
