[Unit]
Description=VOCO Wayland input helper for this login
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionPathExists=/dev/uinput

[Service]
Type=simple
ExecStart=/usr/libexec/voco/ydotool-launcher
UMask=0077
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=3
TimeoutStopSec=1s

[Install]
WantedBy=graphical-session.target
