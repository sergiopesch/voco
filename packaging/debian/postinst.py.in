#!/usr/bin/python3 -I
"""Repair legacy VOCO directory modes and apply the packaged /dev/uinput rule."""
from contextlib import contextmanager
import os
import stat
import subprocess
import sys

DIRECTORIES = @DIRECTORIES@
OPEN_DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


@contextmanager
def root_directory(path):
    fd = os.open(path, OPEN_DIRECTORY)
    try:
        yield fd
    finally:
        os.close(fd)


def repair_directories(root_fd, directories, overrides):
    for path in directories:
        if path in overrides:
            continue
        fd = os.dup(root_fd)
        try:
            for component in path.lstrip('/').split('/'):
                try:
                    child = os.open(component, OPEN_DIRECTORY, dir_fd=fd)
                except FileNotFoundError:
                    # dpkg path-exclude may legitimately omit documentation.
                    break
                os.close(fd)
                fd = child
                info = os.fstat(fd)
                if info.st_uid != 0 or info.st_gid != 0:
                    raise ValueError('VOCO package directory must be root-owned: ' + path)
            else:
                # Repair only the known inherited mode, preserving admin choices.
                if stat.S_IMODE(os.fstat(fd).st_mode) == 0o775:
                    os.fchmod(fd, 0o755)
        finally:
            os.close(fd)


def apply_uinput_rule():
    """Give the active session its /dev/uinput access now rather than at the next
    boot. Best effort: containers and chroots have no udev to ask."""
    for command in (['/usr/sbin/modprobe', 'uinput'],
                    ['/usr/bin/udevadm', 'control', '--reload-rules'],
                    ['/usr/bin/udevadm', 'trigger', '--action=change',
                     '--subsystem-match=misc', '--sysname-match=uinput']):
        try:
            subprocess.run(command, check=False, capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass


if __name__ == '__main__' and len(sys.argv) > 1 and sys.argv[1] == 'configure':
    result = subprocess.run(['/usr/bin/dpkg-statoverride', '--list'],
                            check=False, capture_output=True, text=True)
    if result.returncode not in (0, 1):
        raise RuntimeError('Cannot read administrator permission overrides')
    overrides = {line.split(None, 3)[3] for line in result.stdout.splitlines()}
    with root_directory('/') as root_fd:
        repair_directories(root_fd, DIRECTORIES, overrides)
    apply_uinput_rule()
